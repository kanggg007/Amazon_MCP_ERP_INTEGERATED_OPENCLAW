# Amazon Operations Intelligence Platform — Environment Variables
# NEVER commit the actual .env file. Copy this to .env and fill.

# ── Application ──
LOG_LEVEL=INFO
DEBUG=false

# ── Secrets Mode: 'env' or 'aws_secrets_manager' ──
SECRETS_MODE=env

# ── Store Configuration ──
# Each store gets env vars with STORE_{ID}_{KEY} pattern
# Example for store "store_a":
STORE_STORE_A_LWA_CLIENT_ID=amzn1.application-oa2-client.xxx
STORE_STORE_A_LWA_CLIENT_SECRET=xxx
STORE_STORE_A_REFRESH_TOKEN=Atzr|xxx
STORE_STORE_A_AWS_IAM_ROLE_ARN=arn:aws:iam::xxx:role/sp-api-role
STORE_STORE_A_AWS_ACCESS_KEY_ID=AKIAxxx
STORE_STORE_A_AWS_SECRET_ACCESS_KEY=xxx
STORE_STORE_A_MARKETPLACE_IDS=ATVPDKIKX0DER
STORE_STORE_A_NAME=My US Store

# Additional stores: STORE_STORE_B_..., STORE_STORE_C_...

# ── Walmart ──
# STORE_STORE_A_WALMART_CLIENT_ID=xxx
# STORE_STORE_A_WALMART_CLIENT_SECRET=xxx

# ── TikTok Shop ──
# STORE_STORE_A_TIKTOK_SHOP_CIPHER=xxx

# ── Database ──
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/amazon_ops
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Data Lake ──
DATA_LAKE_PATH=./data_lake
# DATA_LAKE_S3_BUCKET=my-bucket

# ── Alerting ──
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx
# ALERT_EMAIL_FROM=ops@megapower.com
# ALERT_EMAIL_TO=kang@megapower.com

# ── OpenClaw ──
# OPENCLAW_API_KEY=xxx
# OPENCLAW_ALLOW_AUTO=false
